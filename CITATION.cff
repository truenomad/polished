    orcid: "https://orcid.org/0000-0002-9339-4613"
license: MIT
repository-code: "https://github.com/truenomad/polished"
url: "https://truenomad.github.io/polished/"
date-released: "2026-09-27"
keywords:
  - polio
  - poliovirus
  - "acute flaccid paralysis"
  - surveillance
  - epidemiology
  - POLIS
  - GPEI
  - "Global Polio Eradication Initiative"
  - "data cleaning"
  - "data preparation"
  - "r-package"
